{
  "name": "rapid-ai-document-review",
  "private": true,
  "version": "1.2.2",
  "engines": {
    "node": ">=26.1.0"
  },
  "workspaces": [
    "app/shared",
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npm run build --workspace=app/shared && npm run build --workspace=app/backend && npm run build --workspace=app/frontend",
    "dev": "npm run dev --workspace=app/backend",
    "dev:frontend": "npm run dev --workspace=app/frontend",
    "db:migrate": "npm run db:migrate --workspace=app/backend",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:unit": "npm run test:unit --workspace=app/backend",
    "test:integration": "npm run test:integration --workspace=app/backend",
    "test:contract": "npm run test:contract --workspace=app/backend",
    "test:contract:live": "npm run test:contract:live --workspace=app/backend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
