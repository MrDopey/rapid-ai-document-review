# Copy this file to `docker/.env` (docker compose automatically loads a `.env` file from the same
# directory as the compose file passed via `-f`, so no `env_file:` directive is needed) and fill
# in / adjust values as needed.
#
#   cp docker/.env.example docker/.env
#
# `docker/.env` itself is gitignored (see .gitignore's `.env` / `.env.*` / `!.env.example`
# patterns) — never commit real secrets into it.

# --- Required ---

# Pins every new agent conversation to a specific model, in `provider/model` or
# `provider/model:thinkingLevel` format (e.g. anthropic/claude-opus-4-5 or
# anthropic/claude-opus-4-5:high). The backend fails fast at startup if this is unset or blank.
RADR_BE_PI_AGENT_MODEL=google/gemini-3.5-flash-lite

# --- Optional — defaults shown match what docker-compose.yml previously hardcoded ---

# Paths below are inside the container, under the bind-mounted /data (see docker-compose.yml's
# `../app/backend/data:/data` volume, which lands at <repo-root>/app/backend/data on the host).
# Only change these if you also change the bind mount's container-side target to match.
RADR_BE_DATABASE_PATH=/data/document-review.sqlite
RADR_BE_PI_SESSION_STORAGE_PATH=/data/pi-sessions
RADR_BE_PI_CODING_AGENT_DIR=/data/pi-agent

# Pino log level (e.g. debug, info, warn, error).
RADR_BE_LOG_LEVEL=info

# SearXNG-compatible backend for the agent's web_search/web_fetch tools. docker-compose.yml
# bundles its own searxng service at this default — override to point at a different instance.
RADR_BE_SEARXNG_URL=http://searxng:8080

# --- Not currently wired into docker-compose.yml's `environment:` block ---
#
# A model provider credential (e.g. ANTHROPIC_API_KEY) is required for live agent conversations
# but is not passed through to the container by docker-compose.yml today. Add it to this file and
# to the `environment:` block in docker-compose.yml if you need live model calls from the
# containerized deployment.

