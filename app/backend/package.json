{
  "name": "@rapid-ai-document-review/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "node --experimental-strip-types src/storage/sqlite/migrate-cli.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract --exclude '**/live-pi.test.ts' --exclude '**/live-web-tools.test.ts'",
    "test:contract:live": "vitest run tests/contract/live-pi.test.ts tests/contract/live-web-tools.test.ts"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@rapid-ai-document-review/shared": "*",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "typebox": "^1.3.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
